attribute @AllowAnonymous();
attribute @MachineIdOptional();
attribute @DoNotRequireSessionContext();

enum ArgonAuthMode {
    EmailPassword,
    EmailOtp,
    EmailPasswordOtp,
    PasskeyOnly,
    PasskeyWithOtp
}

enum OtpMethod {
    Email,
    Phone,
    Totp
}

msg ArgonIonTicket {
    userId: guid;
    ip: string;
    ray: string;
    clientName: string;
    hostName: string;
    appId: string;
    sessionId: guid;
    machineId: string;
    region: string;
    // What a stream connection is judged by for revocation, as the hub ticket's csid and iat claims.
    credentialSessionIds: guid[];
    issuedAt: datetime;
}

// The operating system a session runs on, as far as the server can tell. Reported by the client
// (X-Argon-Client) or read off the User-Agent; display-only and trusted for nothing.
enum ClientPlatform {
    UNKNOWN,
    WINDOWS,
    MACOS,
    LINUX,
    ANDROID,
    IOS
}
