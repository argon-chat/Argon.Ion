#feature "orleans"

// ManageMessages: moderating other people's messages — taking them down, and being exempt from slow
// mode. It sits above ManageServer rather than in the 1 << 4x moderation block because that block is
// full, and renumbering a flag that is already persisted on archetype rows would silently re-grant
// every existing role something it never had.
flags ArgonEntitlement: u8 {
    None = 0,

    ViewChannel = 1 << 0,
    ReadHistory = 1 << 1,
    JoinToVoice = 1 << 2,

    SendMessages      = 1 << 5,
    SendVoice         = 1 << 6,
    AttachFiles       = 1 << 7,
    AddReactions      = 1 << 8,
    AnyMentions       = 1 << 9,
    MentionEveryone   = 1 << 10,
    ExternalEmoji     = 1 << 11,
    ExternalStickers  = 1 << 12,
    UseCommands       = 1 << 13,
    PostEmbeddedLinks = 1 << 14,

    Connect = 1 << 20,
    Speak   = 1 << 21,
    Video   = 1 << 22,
    Stream  = 1 << 23,

    CanDrawOnStream = 1 << 24,

    UseASIO           = 1 << 30,
    AdditionalStreams = 1 << 31,

    DisconnectMember = 1 << 40,
    MoveMember       = 1 << 41,
    BanMember        = 1 << 42,
    MuteMember       = 1 << 43,
    KickMember       = 1 << 44,

    ManageChannels  = 1 << 50,
    ManageArchetype = 1 << 51,
    ManageBots      = 1 << 52,
    ManageEvents    = 1 << 53,
    ManageBehaviour = 1 << 54,
    ManageServer    = 1 << 55,
    ManageMessages  = 1 << 56
}

service ServerInteraction(spaceId: guid)
{
    // Everything the first screen needs about a space, minus whatever the caller already holds.
    // The client persists all of this and asks again on every sign-in, so the common answer is
    // "nothing moved" — pass the versions from last time and the parts that match come back null.
    GetSpaceSnapshot(known: SpaceVersions?): SpaceSnapshot;

    // Deliberately outside the snapshot: presence changes every few seconds, so bundling it would
    // mean the snapshot version never matches and the whole exchange degrades to a full download.
    GetMemberPresence(): MemberPresence[];

    // TODO: remove once no shipped client calls them. Superseded by GetSpaceSnapshot, which returns
    // the same data, versioned, in one round trip instead of three.
    GetMembers(): RealtimeServerMember[];
    GetMember(userId: guid): RealtimeServerMember;

    GetInviteCodes(): ServerInvites;
    CreateInviteCode(expireMinutes: i4, maxUses: i4): InviteCode;
    RevokeInviteCode(code: InviteCode);

    UpdateSpaceInfo(name: string, description: string);
    SetBoostStripHidden(hidden: bool);
    GetSpaceStats(): SpaceStats;

    PrefetchUser(userId: guid): ArgonUser;
    PrefetchProfile(userId: guid): ArgonUserProfile;

    GetChannels(): RealtimeChannel[];

    GetServerArchetypes(): Archetype[];
    GetDetailedServerArchetypes(): ArchetypeGroup[];

    BeginUploadSpaceProfileHeader(): UploadFileResult;
    CompleteUploadSpaceProfileHeader(blobId: guid);

    BeginUploadSpaceAvatar(): UploadFileResult;
    CompleteUploadSpaceAvatar(blobId: guid);

    BeginUploadInviteImage(): UploadFileResult;
    CompleteUploadInviteImage(blobId: guid);

    GetChannelGroups(): ChannelGroup[];

    // Deleting a space is scheduled, never immediate, and the wait is the point: a space is other
    // people's history too, so everyone in it gets notice and the owner gets time to change their
    // mind. RequestDeleteSpace answers with the moment it will happen; CancelDeleteSpace calls it
    // off any time before then.
    //
    // A community waits longer than a private space — see SpaceDeletionState.executionAt, which the
    // header reads to show the countdown to every member rather than only to the owner.
    RequestDeleteSpace(): RequestDeleteSpaceResult;
    CancelDeleteSpace(): CancelDeleteSpaceResult;
    GetSpaceDeletionState(): SpaceDeletionState;
}

enum SpaceDeletionStatus: u2 {
    NONE,
    SCHEDULED,
    EXECUTING
}

enum SpaceDeletionError: u2 {
    NONE,
    NOT_OWNER,
    ALREADY_SCHEDULED,
    NOT_SCHEDULED,
    ALREADY_EXECUTING,
    INTERNAL_ERROR
}

msg SpaceDeletionState {
    status: SpaceDeletionStatus;
    scheduledAt: datetime?;
    executionAt: datetime?;
    isCommunity: bool;
}

union RequestDeleteSpaceResult {
    SuccessRequestDeleteSpace(state: SpaceDeletionState),
    FailedRequestDeleteSpace(error: SpaceDeletionError)
}

union CancelDeleteSpaceResult {
    SuccessCancelDeleteSpace(),
    FailedCancelDeleteSpace(error: SpaceDeletionError)
}

msg ArgonSpaceBase {
    spaceId: guid;
    name: string;
    description: string;
    avatarFieldId: string?;
    topBannerFileId: string?;
    boostCount: i4;
    boostLevel: i4;
    isVerified: bool;
    isOfficial: bool;
    hideBoostStrip: bool;
    inviteImageFileId: string?;
    // A space run as a public community rather than a private group. Owner-visible consequences
    // live on the server (a longer deletion grace, reports from non-members); the client reads it
    // only to show the "Community" tag next to the name.
    //
    // Nullable only for the wire, same reason as ArgonUserProfile.registeredAt: a client built
    // against the previous schema cannot decode a message that grew a required field. Absent means
    // false — the server always sends it.
    isCommunity: bool?;
}

msg ArgonSpace {
    spaceId: guid;
    name: string;
    description: string;
    avatarFieldId: string?;
    topBannerFileId: string?;
    channels: ArgonChannel[];
    members: SpaceMember[];
    archetypes: Archetype[];
    isVerified: bool;
    isOfficial: bool;
    hideBoostStrip: bool;
    inviteImageFileId: string?;
    isCommunity: bool?;
}

msg ArchetypeGroup {
    archetype: Archetype;
    members: guid[];
}

msg SpaceMemberArchetype {
    serverMemberId: guid;
    archetypeId: guid;
}

msg SpaceMember {
    userId: guid;
    spaceId: guid;
    joinedAt: datetime;
    memberId: guid;
    user: ArgonUser;
    archetypes: SpaceMemberArchetype[];
}

msg RealtimeServerMember
{
    member: SpaceMember;
    status: UserStatus;
    presence: UserActivityPresence?;
}

// What the caller already has, part by part. Each is an opaque token: the client stores whatever it
// was given and hands it back, and nothing but the server ever reads one.
msg SpaceVersions {
    members: string?;
    channels: string?;
    groups: string?;
    archetypes: string?;
}

// A part is null when the caller's version matched, which is not the same as it being empty — an
// empty array means the space genuinely has none of that thing.
msg SpaceSnapshot {
    versions: SpaceVersions;
    members: SpaceMember[]?;
    channels: RealtimeChannel[]?;
    groups: ChannelGroup[]?;
    archetypes: Archetype[]?;
}

msg MemberPresence {
    userId: guid;
    status: UserStatus;
    activity: UserActivityPresence?;
}

msg InviteCodeEntity {
    code: InviteCode;
    spaceId: guid;
    issuerId: guid;
    expireTime: datetime;
    used: u8;
    maxUses: i4;
    createdAt: datetime;
}

msg ServerInvites {
    domain: string;
    invites: InviteCodeEntity[];
}

msg InviteCode {
    inviteCode: string;
}

msg SpaceStats {
    memberCount: i4;
    onlineCount: i4;
    channelCount: i4;
    boostCount: i4;
    boostLevel: i4;
    createdAt: datetime;
}

msg ArgonUser {
    userId: guid;
    username: string;
    displayName: string;
    avatarFileId: string?;
    flags: UserFlag;
}

msg ArgonUserProfile {
    userId: guid;

    // Who this person is in the scope this profile was read for, when a look says so. Null means the
    // account's own name and picture, which is what every look starts out inheriting.
    //
    // Here rather than on ArgonUser because that message rides along with every member list and
    // every broadcast and carries no scope — one row cannot hold an answer that differs per space.
    //
    // Appended and nullable, like every field added to a message that already shipped.
    displayNameOverride: string?;
    avatarFileIdOverride: string?;
    customStatus: string?;
    customStatusIconId: string?;
    bannerFileID: string?;
    dateOfBirth: dateonly?;
    bio: string?;
    badges: string[];
    archetypes: SpaceMemberArchetype[];
    backgroundId: i4?;
    voiceCardEffectId: i4?;
    avatarFrameId: i4?;
    nickEffectId: i4?;
    primaryColor: i4?;
    accentColor: i4?;
    // "In Argon since <date>" on the profile card. Lives here rather than on ArgonUser because
    // ArgonUser rides along with every member list and every UserUpdated broadcast, while this is
    // read once when a card opens — next to friendAt, which is the other half of that same line.
    // Nullable only for the wire: a client built against the previous schema fails to decode the
    // whole profile if a newly added field is required, and every user does have a registration date.
    registeredAt: datetime?;

    // What this person is actually wearing, and which of their loadouts said so.
    //
    // The six fields above are now a PROJECTION of this, kept because installed desktop builds read
    // them and will for some time. A cosmetic that predates the system answers to one of those
    // integers and appears in both places; one that does not is simply invisible to an older build,
    // which is the correct outcome rather than a failure.
    //
    // Nullable for the same reason registeredAt is: a client built against the previous schema
    // cannot decode a profile that grew a required field.
    cosmetics: EquippedCosmetic[]?;
    loadoutId: guid?;
}

// One cosmetic as worn, resolved: the catalogue row's content, not a reference to be looked up.
//
// payloadJson is a string and that is deliberate. Ion has no open-schema value, and a typed union
// per kind would put every kind of cosmetic into this contract — so adding one would be a wire
// change, and deleting a kind's file would leave a case here with nothing behind it. The whole
// design rests on a kind being one file that can be added or removed on its own, so the payload
// crosses as text and the client parses it defensively against the kind it belongs to.
msg EquippedCosmetic {
    kindKey: string;
    itemId: guid;
    slug: string;

    // Compositing order within a surface, low to high, and the position within the kind for the
    // kinds that allow several at once.
    layer: i4;
    slotIndex: i4;

    payloadJson: string;
    assets: EquippedCosmeticAsset[];

    // What the wearer composed on this item's axes, already resolved to the option rows they chose.
    //
    // Resolved here rather than sent as bare slugs because the expensive reader is a member list: a
    // row drawing somebody's name needs the face and the colour in hand, and a second lookup per name
    // is the thing that makes a large space slow. The client folds these into the payload, because
    // what a font means to a nickname is the renderer's business, not the wire's.
    //
    // Appended and nullable, like every field added to a message that already shipped.
    options: EquippedCosmeticOption[]?;

    // What the wearer wrote into this card, for the kinds that have anything to write into, plus
    // where it sits on the profile board and how big it is, in grid cells.
    //
    // Cells rather than an order: a person dragging a card puts it somewhere, and an ordered list can
    // only say what it comes after. The layout runs across kinds, so it travels with the worn row
    // rather than with the kind.
    //
    // Appended and nullable, like every field added to a message that already shipped.
    contentJson: string?;
    boardX: i4?;
    boardY: i4?;
    boardW: i4?;
    boardH: i4?;

    // Which authoring of the catalogue row this is, so a reader can tell a cached copy from the
    // current one.
    //
    // The payload travels with the profile, and profiles are cached on the client for hours. An
    // operator who re-authors a published row therefore reaches nobody who already holds the
    // profile: they keep rendering what was true when it was fetched, and there is no event for it
    // because nothing about the person changed. The catalogue already carries the same number, so a
    // client that reads the catalogue can compare the two and drop exactly the profiles that are
    // behind — rather than everything, on a timer, or not at all.
    //
    // Appended and nullable, like every field added to a message that already shipped.
    version: i4?;
}

// One option chosen on one axis: the row, its payload, and whatever file it carries.
msg EquippedCosmeticOption {
    facetId: string;
    kindKey: string;
    itemId: guid;
    slug: string;
    payloadJson: string;
    assets: EquippedCosmeticAsset[];

    // As on the worn row above, and for the same reason: an option is a catalogue row too, and
    // re-authoring a colour has to reach the people already wearing it.
    //
    // Appended and nullable, like every field added to a message that already shipped.
    version: i4?;
}

// A file the cosmetic draws with. Carries the id only: the client builds the URL through cdnUrl(),
// because a server-provided absolute URL gets cached by whoever received it and pins a region that
// may not be theirs tomorrow.
msg EquippedCosmeticAsset {
    slot: string;
    fileId: string;
}

flags UserFlag : i4
{
    NONE = 0,
    BOT = 1 << 0,
    SYSTEM = 1 << 1,
    VERIFIED = 1 << 2,
    PREMIUM = 1 << 3,
    BANNED = 1 << 4,
    DELETED = 1 << 5
}

enum UserStatus
{
    Offline,
    Online,
    Away,
    InGame,
    Listen,
    TouchGrass,
    DoNotDisturb
}
