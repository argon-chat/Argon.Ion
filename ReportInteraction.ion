

// What a report points at. The server resolves the target itself and refuses anything the reporter
// cannot see, so a client only ever names things it has already been shown.
//
//   PROFILE / USER    targetId = the user. The two are one thing server-side; both are kept because
//                     the values are already on the wire.
//   MESSAGE           targetId = the author, channelId = the space channel, messageId = the message.
//   DIRECT_MESSAGE    targetId = the author (the peer), channelId = the peer as well, messageId = the
//                     message. Older clients send these as MESSAGE with channelId = peer; the server
//                     recognises that shape too.
//   CHANNEL           targetId = the channel.
//   SPACE             targetId = the space.
enum ReportTargetKind {
    PROFILE,
    MESSAGE,
    CHANNEL,
    SPACE,
    USER,
    DIRECT_MESSAGE
}

enum ReportCategory {
    I_DONT_LIKE_IT,
    CHILD_ABUSE,
    VIOLENCE,
    ILLEGAL_GOODS,
    ILLEGAL_ADULT_CONTENT,
    PERSONAL_DATA,
    SCAM_OR_FRAUD,
    COPYRIGHT,
    SPAM,
    OTHER
}

enum ReportReason {
    NONE,
    CHILD_SEXUAL_ABUSE,
    CHILD_PHYSICAL_ABUSE,
    INSULTS_OR_FALSE_INFO,
    GRAPHIC_OR_DISTURBING_CONTENT,
    EXTREME_VIOLENCE,
    HATE_SPEECH_OR_SYMBOL,
    CALLING_FOR_VIOLENCE,
    ORGANIZED_CRIME,
    TERRORISM,
    ANIMAL_ABUSE,
    WEAPONS,
    DRUGS,
    FAKE_DOCUMENTS,
    COUNTERFEIT_MONEY,
    HACKING_TOOLS_AND_MALWARE,
    COUNTERFEIT_MERCHANDISE,
    OTHER_GOODS_AND_SERVICES,
    IAC_CHILD_ABUSE,
    ILLEGAL_SEXUAL_SERVICES,
    IAC_ANIMAL_ABUSE,
    NON_CONSENSUAL_SEXUAL_IMAGERY,
    PORNOGRAPHY,
    IAC_OTHER,
    PRIVATE_IMAGES,
    PHONE_NUMBER,
    ADDRESS,
    STOLEN_DATA_OR_CREDENTIALS,
    PD_OTHER,
    IMPERSONATION,
    DECEPTIVE_FINANCIAL_CLAIMS,
    SF_MALWARE,
    PHISHING,
    FRAUDULENT_SELLER,
    SPAM_INSULTS_OR_FALSE_INFO,
    PROMOTING_ILLEGAL_CONTENT,
    SPAM_OTHER,
    OTHER_I_DONT_LIKE_IT,
    OTHER_FALSE_INFO,
    OTHER_ILLEGAL_ADULT_CONTENT,
    OTHER_ILLEGAL_GOODS_AND_SERVICES,
    OTHER_ELSE
}

enum ReportStatus {
    PENDING,
    UNDER_REVIEW,
    RESOLVED_ACTION_TAKEN,
    RESOLVED_NO_ACTION,
    DISMISSED,
    ESCALATED
}

enum SubmitReportError {
    NONE,
    INVALID_TARGET,
    CANNOT_REPORT_SELF,
    DUPLICATE_REPORT,
    RATE_LIMITED,
    TARGET_NOT_FOUND,
    INTERNAL_ERROR
}


msg ReportTarget {
    kind: ReportTargetKind;
    targetId: guid;
    channelId: guid?;
    messageId: u8?;
}

msg CreateReportInput {
    target: ReportTarget;
    category: ReportCategory;
    reason: ReportReason;
    additionalInfo: string?;
    referenceReportId: guid?;
}

msg ReportInfo {
    reportId: guid;
    reporterId: guid;
    target: ReportTarget;
    category: ReportCategory;
    reason: ReportReason;
    additionalInfo: string?;
    status: ReportStatus;
    referenceReportId: guid?;
    createdAt: datetime;
}

msg UserTrustInfo {
    userId: guid;
    trustScore: i4;
    totalReportsReceived: i4;
    confirmedReportsReceived: i4;
    totalReportsFiled: i4;
    falseReportsFiled: i4;
    lastUpdated: datetime;
}


union SubmitReportResult {
    SuccessSubmitReport(reportId: guid),
    FailedSubmitReport(error: SubmitReportError)
}


// SubmitReport answers SuccessSubmitReport for everything the client did right, whether or not the
// report was kept: a duplicate, a rate-limited or a low-standing submission is acknowledged exactly
// like a stored one, and the receipt id says nothing about which it was. The errors are the ones a
// client can act on — a target it should not have offered, or the caller reporting themself.
//
// GetMyReports is deliberately empty. A reporter learns the outcome through a system notification
// when a case closes; a browsable history would let them tell which reports stuck and which were
// dropped, which is the signal a nuisance reporter tunes against.
service ReportInteraction() {
    SubmitReport(input: CreateReportInput): SubmitReportResult;
    GetMyReports(limit: i4, offset: i4): ReportInfo[];
}
