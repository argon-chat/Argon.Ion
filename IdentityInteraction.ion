service IdentityInteraction() {
    @AllowAnonymous()
    Authorize(data: UserCredentialsInput): AuthorizeResult;
    @AllowAnonymous()
    Registration(data: NewUserCredentialsInput): RegistrationResult;

    @AllowAnonymous()
    BeginResetPassword(email: string): bool;
    @AllowAnonymous()
    ResetPassword(email: string, otpCode: string, newPassword: string): AuthorizeResult;

    @AllowAnonymous()
    GetAuthorizationScenario(): string;

    @AllowAnonymous()
    GetAuthorizationScenarioFor(data: UserLoginInput): string;

    @AllowAnonymous()
    @DoNotRequireSessionContext()
    GetMyAuthorization(token: string, refreshToken: string?): MyAuthStatus;

    @AllowAnonymous()
    CreateLoginRequest(): CreateLoginRequestResult;
    @AllowAnonymous()
    PollLoginRequest(token: string): LoginPollResult;

    PreviewLoginRequest(token: string): LoginRequestPreviewResult;
    ApproveLoginRequest(token: string): ApproveLoginRequestResult;
    RejectLoginRequest(token: string): RejectLoginRequestResult;
}

union CreateLoginRequestResult {
    SuccessCreateLoginRequest(ticket: LoginRequestTicket),
    FailedCreateLoginRequest(error: LoginRequestError)
}

msg LoginRequestTicket {
    token: string;
    expiresAt: datetime;
}

union LoginPollResult {
    PendingLoginRequest(expiresAt: datetime),
    ApprovedLoginRequest(token: string, refreshToken: string?),
    RejectedLoginRequest(),
    FailedLoginPoll(error: LoginRequestError)
}

union LoginRequestPreviewResult {
    SuccessLoginRequestPreview(preview: LoginRequestPreview),
    FailedLoginRequestPreview(error: LoginRequestError)
}

msg LoginRequestPreview {
    clientName: string;
    hostName: string?;
    ip: string;
    region: string;
    createdAt: datetime;
    expiresAt: datetime;
}

union ApproveLoginRequestResult {
    SuccessApproveLoginRequest(),
    FailedApproveLoginRequest(error: LoginRequestError)
}

union RejectLoginRequestResult {
    SuccessRejectLoginRequest(),
    FailedRejectLoginRequest(error: LoginRequestError)
}

enum LoginRequestError {
    NONE,
    NOT_FOUND,
    EXPIRED,
    ALREADY_USED,
    DEVICE_MISMATCH,
    RATE_LIMITED,
    INTERNAL_ERROR
}

union MyAuthStatus {
    GoodAuthStatus(token: string),
    BadAuthStatus(error: BadAuthKind),
    LockedAuthStatus(lockdownReason: LockdownReason?, lockDownExpiration: datetime?, isAppealable: bool, severity: LockdownSeverity),
    CertificateErrorAuthStatus(message: string)
}

enum BadAuthKind {
    SESSION_EXPIRED,
    REQUIRED_RELOGIN,
    BAD_TOKEN
}