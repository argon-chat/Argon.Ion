#feature "orleans"


service ArchetypeInteraction(spaceId: guid) {
    GetServerArchetypes(): Archetype[];
    CreateArchetype(name: string): Archetype;
    UpdateArchetype(data: Archetype): Archetype;
    SetArchetypeToMember(memberId: guid, archetypeId: guid, isGrant: bool): bool;
    GetDetailedServerArchetypes(): ArchetypeGroup[];
    UpsertArchetypeEntitlementForChannel(channelId: guid, archetypeId: guid,
            deny: ArgonEntitlement, allow: ArgonEntitlement): ChannelEntitlementOverwrite?;
    GetChannelEntitlementOverwrites(channelId: guid): ChannelEntitlementOverwrite[];
    DeleteEntitlementForChannel(channelId: guid, entitlementOverwriteId: guid): bool;

    DeleteArchetype(archetypeId: guid): DeleteArchetypeResult;
    ReorderArchetypes(ordered: guid[]): ReorderArchetypesResult;
}

enum ArchetypeError: u2 {
    NONE,
    NOT_FOUND,
    NO_PERMISSION,
    IS_DEFAULT,
    IS_LOCKED,
    IN_USE,
    INCOMPLETE_ORDER,
    INTERNAL_ERROR
}

union DeleteArchetypeResult {
    SuccessDeleteArchetype(),
    FailedDeleteArchetype(error: ArchetypeError)
}

union ReorderArchetypesResult {
    SuccessReorderArchetypes(archetypes: Archetype[]),
    FailedReorderArchetypes(error: ArchetypeError)
}

msg ChannelEntitlementOverwrite {
    channelId: guid;
    archetypeId: guid?;
    serverMemberId: guid?;
    allow: ArgonEntitlement;
    deny: ArgonEntitlement;


    creatorId: guid;
    id: guid;
}

msg Archetype
{
    id: guid;
    spaceId: guid;
    name: string;
    description: string;

    isMentionable: bool;
    colour: i4;
    isHidden: bool;
    isLocked: bool;
    isGroup: bool;
    isDefault: bool;

    iconFileId: string?;

    entitlement: ArgonEntitlement;

    // Rank in the space, highest first: the member list groups by the top archetype a member
    // holds, and before this field it had to guess from arrival order. Set only by
    // ReorderArchetypes — UpdateArchetype ignores it, so an edit cannot silently repack the
    // hierarchy while somebody else is dragging it.
    //
    // Nullable so a reader built before this field still deserializes (ION0029), and because null
    // is the honest value for every archetype minted before the first reorder: unranked, not zero.
    order: i4?;
}
